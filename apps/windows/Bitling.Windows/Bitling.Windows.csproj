<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Bitling</AssemblyName>
    <RootNamespace>Bitling</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Set once a real icon is generated; LoadTrayIcon() falls back gracefully if missing. -->
    <!-- <ApplicationIcon>Resources\Bitling.ico</ApplicationIcon> -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- pet.html / panel.html are generated by packages/pet-engine into Resources/ before
         building (see apps/windows/build.ps1); avatars/pets are copied verbatim. -->
    <None Include="Resources\**\*" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Resources')" />
    <None Include="..\cli\bitling.ps1" Link="bitling.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
