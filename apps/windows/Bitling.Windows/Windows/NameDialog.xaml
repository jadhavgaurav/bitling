<Window x:Class="Bitling.Windows.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bitling"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True">
    <StackPanel Margin="20">
        <TextBlock x:Name="Headline" FontSize="15" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
        <TextBlock x:Name="Body" TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.8"/>
        <TextBox x:Name="NameBox" Padding="4" FontSize="13"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Padding="12,4" Margin="0,0,8,0" Click="OnCancel" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Padding="12,4" Click="OnOk" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
