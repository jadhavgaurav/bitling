#!/bin/bash
# Bitling command line: tell the desktop pet what just happened.
#
#   bitling run <command...>              run tests; the pet reacts to pass or fail
#   bitling deploy <target> <command...>  run a deploy; the pet shows progress, then rocket or error
#   bitling event <kind> [key=value...]   raw event, e.g. `bitling event test-failed count=3 name=api`
#                                         test names: tests=test_a,test_b (they crawl your screen)
#   bitling say <text>                    make the pet say something
#   bitling claude                        Claude Code hook adapter (reads hook JSON on stdin)
#   bitling git <hook> [args]             global git hook adapter (installed for you by the menu)
#
# Events travel over the bitling:// URL scheme, so this works from any shell, Makefile,
# npm script or git hook on the same Mac. Exit status of the wrapped command is preserved.
set -u

usage() {
  sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
}

encode() {
  python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"
}

send() {
  local kind="$1"
  shift
  local query=""
  local pair key value
  for pair in "$@"; do
    key="${pair%%=*}"
    value="${pair#*=}"
    query="${query}&${key}=$(encode "$value")"
  done
  open -g "bitling://${kind}?${query#&}" 2>/dev/null || true
}

command_name="${1:-}"
shift || true

case "$command_name" in
  run)
    [ $# -gt 0 ] || { usage; exit 2; }
    name="$(basename "$PWD")"
    log="$(mktemp -t bitling)"
    ( set -o pipefail; "$@" 2>&1 | tee "$log" )
    status=$?
    count="$(grep -Eo '[0-9]+ (failed|failing)' "$log" | tail -1 | grep -Eo '^[0-9]+' || true)"
    rm -f "$log"
    if [ "$status" -eq 0 ]; then
      send test-passed "name=$name"
    else
      send test-failed "name=$name" "count=${count:-0}"
    fi
    exit "$status"
    ;;
  deploy)
    target="${1:-}"
    shift || true
    [ -n "$target" ] && [ $# -gt 0 ] || { usage; exit 2; }
    send deploy-started "target=$target"
    "$@"
    status=$?
    if [ "$status" -eq 0 ]; then
      send deploy-finished "target=$target"
    else
      send deploy-failed "target=$target"
    fi
    exit "$status"
    ;;
  event)
    kind="${1:-}"
    shift || true
    [ -n "$kind" ] || { usage; exit 2; }
    send "$kind" "$@"
    ;;
  say)
    [ $# -gt 0 ] || { usage; exit 2; }
    send say "text=$*"
    ;;
  git)
    # Global git hook adapter: `bitling git <hook-name> [hook args]` inside a repository.
    hook="${1:-}"
    shift || true
    top="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    repo="$(basename "$top")"
    branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    case "$hook" in
      post-commit)
        hash="$(git rev-parse HEAD 2>/dev/null || true)"
        message="$(git log -1 --format=%s 2>/dev/null || true)"
        stat="$(git show --shortstat --format= HEAD 2>/dev/null | tail -1)"
        files="$(printf '%s' "$stat" | grep -Eo '[0-9]+ file' | grep -Eo '[0-9]+' || true)"
        ins="$(printf '%s' "$stat" | grep -Eo '[0-9]+ insertion' | grep -Eo '[0-9]+' || true)"
        del="$(printf '%s' "$stat" | grep -Eo '[0-9]+ deletion' | grep -Eo '[0-9]+' || true)"
        send commit "repo=$repo" "branch=$branch" "hash=$hash" "message=$message" "files=${files:-0}" "insertions=${ins:-0}" "deletions=${del:-0}"
        ;;
      post-merge) send merge "repo=$repo" "branch=$branch" ;;
      post-checkout) [ "${3:-0}" = "1" ] && send checkout "repo=$repo" "branch=$branch" ;;
      post-rewrite) if [ "${1:-}" = "amend" ]; then send amend "repo=$repo" "branch=$branch"; else send rebase-done "repo=$repo" "branch=$branch"; fi ;;
      pre-push) send push "repo=$repo" "branch=$branch" ;;
      *) ;;
    esac
    exit 0
    ;;
  claude)
    # Claude Code hook adapter: reads the hook JSON on stdin and forwards one event.
    # The payload travels through the environment because python's program text uses stdin.
    BITLING_PAYLOAD="$(cat)" python3 - <<'PY'
import json, subprocess, sys, urllib.parse, os
try:
    data = json.loads(os.environ.get("BITLING_PAYLOAD", ""))
except Exception:
    sys.exit(0)
event = data.get("hook_event_name", "")
cwd = data.get("cwd") or os.getcwd()
project = os.path.basename(cwd.rstrip("/")) or cwd
kind = None
params = {"name": project}
if event == "SessionStart":
    kind = "claude-session-start"
elif event == "UserPromptSubmit":
    kind = "claude-prompt"
    params["message"] = str(data.get("prompt", ""))[:80]
elif event == "PreToolUse":
    kind = "claude-tool"
    tool_input = data.get("tool_input") or {}
    params["name"] = str(data.get("tool_name", "tool"))
    params["message"] = str(tool_input.get("command") or tool_input.get("file_path") or tool_input.get("pattern") or "")[:80]
elif event == "Stop":
    kind = "claude-done"
elif event == "Notification":
    kind = "claude-notify"
    params["message"] = str(data.get("message", ""))[:80]
elif event == "SessionEnd":
    kind = "claude-session-end"
if kind:
    query = "&".join(f"{k}={urllib.parse.quote(v, safe='')}" for k, v in params.items() if v)
    subprocess.run(["open", "-g", f"bitling://{kind}?{query}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
PY
    exit 0
    ;;
  *)
    usage
    exit 2
    ;;
esac
